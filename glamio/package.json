{
  "name": "glamio",
  "version": "1.0.0",
  "description": "GLAMIO – App web de formación en belleza (uñas, cabello y cejas)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:crear": "psql -U postgres -d glamio -f db/schema.sql",
    "db:datos": "psql -U postgres -d glamio -f db/seed.sql",
    "test": "node test/ejecutar.js",
    "test:simulado": "node -e \"process.env.CORREO_PRUEBAS='simulado'; require('./test/ejecutar.js')\"",
    "db:migrar-login": "psql -U postgres -d glamio -f db/migracion-login.sql"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.12.0"
  }
}
