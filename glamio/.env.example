# =========================================================
# GLAMIO – Configuración local
# 1. Copia este archivo y llámalo .env (en la misma carpeta que server.js)
# 2. Cambia los valores que pone «CAMBIAR»
# El archivo .env NO se sube a git (está en .gitignore): ahí van tus contraseñas.
# =========================================================

# --- Servidor ---
# Puerto donde se abre la app: http://localhost:3000
PORT=3000

# Dirección de la app (para los enlaces de los correos)
URL_APP=http://localhost:3000

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
# Usuario de PostgreSQL (al instalarlo se crea "postgres")
DB_USER=postgres
# CAMBIAR por la contraseña que pusiste al instalar PostgreSQL
DB_PASSWORD=CAMBIAR-tu-contraseña-de-postgres
# Nombre de la base que se crea con: createdb -U postgres glamio
DB_NAME=glamio

# --- Base de datos SOLO para las pruebas (npm test la borra y la crea de nuevo) ---
DB_NAME_TEST=glamio_test
PORT_TEST=3999

# --- Correos REALES (verificar email, recuperar contraseña) ---
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (16 letras; ponlas sin espacios).
# NO es tu contraseña normal de Gmail.
# Para no enviar correos (se ven en la consola): CORREO_MODO=simulado
SMTP_USUARIO=CAMBIAR-tucorreo@gmail.com
SMTP_PASSWORD=CAMBIAR-las-16-letras
CORREO_MODO=real
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
